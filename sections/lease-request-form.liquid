<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="lease-request-section section section--page-width color-{{ section.settings.color_scheme }} spacing-style"
     style="{% render 'spacing-style', settings: section.settings %}"
     data-section-id="{{ section.id }}">
  
  <div class="lease-request-layout">
    
    {%- comment -%} Left Column - Dynamic Section {%- endcomment -%}
    <div class="lease-request-sidebar">
      {%- if section.settings.heading != blank -%}
        <h1 class="lease-request-heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      
      {%- if section.settings.subheading != blank -%}
        <div class="lease-request-subheading rte">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}

      {%- comment -%} Render blocks for custom content {%- endcomment -%}
      <div class="lease-request-content">
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when 'text' %}
                <div class="content-block content-block--text">
                  {% if block.settings.heading != blank %}
                    <h3>{{ block.settings.heading }}</h3>
                  {% endif %}
                  <div class="rte">
                    {{ block.settings.text }}
                  </div>
                </div>
              
              {% when 'icon_with_text' %}
                <div class="content-block content-block--icon">
                  <div class="icon-with-text-item">
                    {% if block.settings.icon != blank %}
                      <div class="icon-wrapper">
                        {% render 'icon', icon: block.settings.icon %}
                      </div>
                    {% endif %}
                    <div class="icon-content">
                      {% if block.settings.heading != blank %}
                        <h4>{{ block.settings.heading }}</h4>
                      {% endif %}
                      {% if block.settings.text != blank %}
                        <p>{{ block.settings.text }}</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              
              {% when 'image' %}
                <div class="content-block content-block--image">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 600 }}" 
                         alt="{{ block.settings.image.alt | escape }}"
                         loading="lazy">
                  {% endif %}
                </div>
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    </div>

    {%- comment -%} Right Column - Form {%- endcomment -%}
    <div class="lease-request-form-wrapper">
      
      {%- comment -%} Error state - no sessionStorage data {%- endcomment -%}
      <div class="lease-request-error hidden" data-no-data-error>
        <div class="lease-request-error__content">
          <span class="svg-wrapper">
            {{- 'icon-error.svg' | inline_asset_content -}}
          </span>
          <div>
            <h2>Geen product geselecteerd</h2>
            <p>Je hebt nog geen fiets gekozen. Ga terug naar onze collectie en selecteer een fiets om te leasen.</p>
            <a href="{{ routes.all_products_collection_url }}" class="button">
              Bekijk fietsen
            </a>
          </div>
        </div>
      </div>

      {%- comment -%} Form {%- endcomment -%}
      <form class="lease-form hidden" 
            id="lease-request-form"
            data-lease-form
            novalidate>
        
        {%- comment -%} Product Information Grid {%- endcomment -%}
        <div class="form-section">
          <h2 class="form-section-title">Geselecteerde Fiets</h2>
          
          <div class="form-grid form-grid--two-column">
            <div class="form-group form-group--readonly">
              <label class="form-label">Soort fiets</label>
              <input type="text" class="form-input" data-field="productType" value="-" readonly>
            </div>

            <div class="form-group form-group--readonly">
              <label class="form-label">Merk</label>
              <input type="text" class="form-input" data-field="vendor" value="-" readonly>
            </div>

            <div class="form-group form-group--readonly">
              <label class="form-label">Model</label>
              <input type="text" class="form-input" data-field="productTitle" value="-" readonly>
            </div>

            <div class="form-group form-group--readonly">
              <label class="form-label">Accupakket</label>
              <input type="text" class="form-input" data-field="battery" value="-" readonly>
            </div>

            <div class="form-group form-group--readonly">
              <label class="form-label">Kleur</label>
              <input type="text" class="form-input" data-field="color" value="-" readonly>
            </div>

            <div class="form-group form-group--readonly">
              <label class="form-label">Versnellingen</label>
              <input type="text" class="form-input" data-field="gears" value="-" readonly>
            </div>

            <div class="form-group form-group--readonly">
              <label class="form-label">Maat & Klantgroep</label>
              <input type="text" class="form-input" data-field="framesize" value="-" readonly>
            </div>

            <div class="form-group form-group--readonly">
              <label class="form-label">Adviesprijs</label>
              <input type="text" class="form-input" data-field="retailPrice" value="-" readonly>
            </div>
          </div>

          {%- comment -%} Lease Price - Full Width {%- endcomment -%}
          <div class="form-group form-group--readonly form-group--highlight">
            <label class="form-label">Leaseprijs per maand</label>
            <input type="text" class="form-input form-input--price" data-field="leasePrice" value="-" readonly>
          </div>
        </div>

        {%- comment -%} Customer Information Grid {%- endcomment -%}
        <div class="form-section">
          <h2 class="form-section-title">Jouw Gegevens</h2>
          
          <div class="form-grid form-grid--two-column">
            <div class="form-group">
              <label for="customer-salutation" class="form-label">
                Aanhef <span class="required">*</span>
              </label>
              <select 
                id="customer-salutation" 
                name="salutation"
                class="form-input"
                required
                data-customer-field>
                <option value="">Selecteer...</option>
                <option value="1">Dhr.</option>
                <option value="2">Mevr.</option>
                <option value="3">Anders</option>
              </select>
              <span class="form-error" data-error="salutation"></span>
            </div>

            <div class="form-group">
              <label for="customer-initials" class="form-label">
                Voorletter(s) <span class="required">*</span>
              </label>
              <input 
                type="text" 
                id="customer-initials" 
                name="initials"
                class="form-input"
                required
                placeholder="AB"
                data-customer-field>
              <span class="form-error" data-error="initials"></span>
            </div>

            <div class="form-group">
              <label for="customer-prefix" class="form-label">
                Tussenvoegsel
              </label>
              <input 
                type="text" 
                id="customer-prefix" 
                name="prefix"
                class="form-input"
                placeholder="van, de, etc."
                data-customer-field>
            </div>

            <div class="form-group">
              <label for="customer-lastname" class="form-label">
                Achternaam <span class="required">*</span>
              </label>
              <input 
                type="text" 
                id="customer-lastname" 
                name="lastname"
                class="form-input"
                required
                placeholder="Achternaam"
                data-customer-field>
              <span class="form-error" data-error="lastname"></span>
            </div>

            <div class="form-group form-group--full-width">
              <label for="customer-birthdate" class="form-label">
                Geboortedatum <span class="required">*</span>
              </label>
              <input 
                type="date" 
                id="customer-birthdate" 
                name="birthdate"
                class="form-input"
                required
                data-customer-field>
              <span class="form-error" data-error="birthdate"></span>
            </div>

            <div class="form-group">
              <label for="customer-street" class="form-label">
                Straat <span class="required">*</span>
              </label>
              <input 
                type="text" 
                id="customer-street" 
                name="street"
                class="form-input"
                required
                placeholder="Straatnaam"
                data-customer-field>
              <span class="form-error" data-error="street"></span>
            </div>

            <div class="form-group">
              <label for="customer-housenumber" class="form-label">
                Huisnummer <span class="required">*</span>
              </label>
              <input 
                type="text" 
                id="customer-housenumber" 
                name="housenumber"
                class="form-input"
                required
                placeholder="123"
                data-customer-field>
              <span class="form-error" data-error="housenumber"></span>
            </div>

            <div class="form-group">
              <label for="customer-addition" class="form-label">
                Toevoeging
              </label>
              <input 
                type="text" 
                id="customer-addition" 
                name="addition"
                class="form-input"
                placeholder="A, bis, etc."
                data-customer-field>
            </div>

            <div class="form-group">
              <label for="customer-zipcode" class="form-label">
                Postcode <span class="required">*</span>
              </label>
              <input 
                type="text" 
                id="customer-zipcode" 
                name="zipcode"
                class="form-input"
                required
                placeholder="1234AB"
                pattern="[0-9]{4}[A-Za-z]{2}"
                data-customer-field>
              <span class="form-error" data-error="zipcode"></span>
            </div>

            <div class="form-group">
              <label for="customer-city" class="form-label">
                Plaats <span class="required">*</span>
              </label>
              <input 
                type="text" 
                id="customer-city" 
                name="city"
                class="form-input"
                required
                placeholder="Plaatsnaam"
                data-customer-field>
              <span class="form-error" data-error="city"></span>
            </div>

            <div class="form-group">
              <label for="customer-phone" class="form-label">
                Telefoonnummer <span class="required">*</span>
              </label>
              <input 
                type="tel" 
                id="customer-phone" 
                name="phone"
                class="form-input"
                required
                placeholder="0612345678"
                data-customer-field>
              <span class="form-error" data-error="phone"></span>
            </div>

            <div class="form-group form-group--full-width">
              <label for="customer-email" class="form-label">
                E-mailadres <span class="required">*</span>
              </label>
              <input 
                type="email" 
                id="customer-email" 
                name="email"
                class="form-input"
                required
                placeholder="jouw@email.nl"
                data-customer-field>
              <span class="form-error" data-error="email"></span>
            </div>
          </div>
        </div>

        {%- comment -%} Privacy Disclaimer {%- endcomment -%}
        {%- if section.settings.privacy_text != blank -%}
          <div class="form-privacy">
            <div class="rte">
              {{ section.settings.privacy_text }}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Hidden fields {%- endcomment -%}
        <input type="hidden" name="product_id" data-hidden="productId">
        <input type="hidden" name="variant_id" data-hidden="variantId">
        <input type="hidden" name="lease_price" data-hidden="leasePriceValue">
        <input type="hidden" name="timestamp" data-hidden="timestamp">

        {%- comment -%} Honeypot {%- endcomment -%}
        <input type="text" name="honeypot" class="visually-hidden" tabindex="-1" autocomplete="off">

        {%- comment -%} Submit Button {%- endcomment -%}
        <div class="form-actions">
          <button type="submit" class="button button--primary lease-request-submit" data-submit-button>
            <span data-submit-text>{{ section.settings.submit_button_text }}</span>
            <span data-submit-loading class="hidden">Versturen...</span>
          </button>
        </div>

        {%- comment -%} Form Error {%- endcomment -%}
        <div class="form-message form-message--error hidden" data-form-error role="alert">
          <span class="svg-wrapper">
            {{- 'icon-error.svg' | inline_asset_content -}}
          </span>
          <span data-form-error-text>{{ section.settings.error_message }}</span>
        </div>
      </form>

      {%- comment -%} Success State {%- endcomment -%}
      <div class="lease-request-success hidden" data-success-message>
        <div class="lease-request-success__content">
          <span class="svg-wrapper svg-wrapper--success">
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
          </span>
          <div>
            <h2>Aanvraag verzonden!</h2>
            <p>{{ section.settings.success_message }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="button">
              Terug naar fietsen
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  const form = document.querySelector('[data-lease-form]');
  const noDataError = document.querySelector('[data-no-data-error]');
  const successMessage = document.querySelector('[data-success-message]');
  const submitButton = document.querySelector('[data-submit-button]');
  const formError = document.querySelector('[data-form-error]');
  
  // Field mapping for variant options to form fields
  const fieldMapping = {
    'Framesize': 'framesize',
    'Framemaat':  'framesize',
    'Maat': 'framesize',
    'Size': 'framesize',
    'Kleur': 'color',
    'Color': 'color',
    'Accucapaciteit': 'battery',
    'Accupakket': 'battery',
    'Accu': 'battery',
    'Battery': 'battery',
    'Versnellingen': 'gears',
    'Gears': 'gears'
  };
  
  // Load data from sessionStorage
  function loadLeaseData() {
    try {
      const dataString = sessionStorage.getItem('leaseRequest');
      
      if (!dataString) {
        showNoDataError();
        return null;
      }
      
      const data = JSON.parse(dataString);
      
      if (!data.productTitle || !data.variantId || !data.leasePrice) {
        showNoDataError();
        return null;
      }
      
      return data;
    } catch (error) {
      console.error('Error loading lease data:', error);
      showNoDataError();
      return null;
    }
  }
  
  function showNoDataError() {
    noDataError.classList.remove('hidden');
    form.classList.add('hidden');
  }
  
  // Populate form with data
  function populateForm(data) {
    // Basic product info
    setFieldValue('vendor', data.vendor || '-');
    setFieldValue('productTitle', data.productTitle || '-');
    setFieldValue('productType', data.productType || '-');
    setFieldValue('leasePrice', data.leasePrice || '-');
    // Zet advies prijs om naar euro:
    setFieldValue('retailPrice', formatEuroCents(data.retailPrice));

    
    // Map variant options to specific fields
    if (data.variantOptions) {
      Object.entries(data.variantOptions).forEach(([key, value]) => {
        const fieldName = fieldMapping[key];
        if (fieldName) {
          setFieldValue(fieldName, value);
        }
      });
    }
    
    // Hidden fields
    setHiddenField('productId', data.productId);
    setHiddenField('variantId', data.variantId);
    setHiddenField('leasePriceValue', data.leasePrice.replace(/[^0-9.,]/g, ''));
    setHiddenField('timestamp', data.timestamp);
    
    form.classList.remove('hidden');
  }
  
  function setFieldValue(fieldName, value) {
    const field = document.querySelector(`[data-field="${fieldName}"]`);
    if (field) {
      field.value = value || '-';
    }
  }
  
  function setHiddenField(fieldName, value) {
    const field = document.querySelector(`[data-hidden="${fieldName}"]`);
    if (field) {
      field.value = value || '';
    }
  }
  
  // Validate form
  function validateForm() {
    let isValid = true;
    
    // Clear previous errors
    document.querySelectorAll('.form-error').forEach(el => el.textContent = '');
    document.querySelectorAll('.form-input, .form-textarea').forEach(el => {
      el.classList.remove('form-input--error');
    });
    
    // Validate required fields
    const requiredFields = form.querySelectorAll('[required]');
    requiredFields.forEach(field => {
      if (!field.value.trim()) {
        showFieldError(field, 'Dit veld is verplicht');
        isValid = false;
      }
    });
    
    // Validate email
    const emailField = form.querySelector('[type="email"]');
    if (emailField && emailField.value.trim()) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailField.value.trim())) {
        showFieldError(emailField, 'Voer een geldig e-mailadres in');
        isValid = false;
      }
    }
    
    // Validate phone
    const phoneField = form.querySelector('[type="tel"]');
    if (phoneField && phoneField.value.trim()) {
      const phoneRegex = /^\d{10}$/;
      if (!phoneRegex.test(phoneField.value.trim()) || phoneField.value.trim().length < 10) {
        showFieldError(phoneField, 'Voer een geldig telefoonnummer in. Alleen cijfers.');
        isValid = false;
      }
    }
    
    // Validate zipcode
    const zipcodeField = form.querySelector('[name="zipcode"]');
    if (zipcodeField && zipcodeField.value.trim()) {
      const zipcodeRegex = /^[0-9]{4}\s?[A-Za-z]{2}$/;
      if (!zipcodeRegex.test(zipcodeField.value.trim())) {
        showFieldError(zipcodeField, 'Voer een geldige postcode in (1234AB)');
        isValid = false;
      }
    }
    
    // Validate birthdate (must be 18+)
    const birthdateField = form.querySelector('[name="birthdate"]');
    if (birthdateField && birthdateField.value) {
      const birthDate = new Date(birthdateField.value);
      const today = new Date();
      let age = today.getFullYear() - birthDate.getFullYear();
      const monthDiff = today.getMonth() - birthDate.getMonth();
      if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
        age--;
      }
      if (age < 18) {
        showFieldError(birthdateField, 'Je moet minimaal 18 jaar zijn');
        isValid = false;
      }
    }
    
    // Check honeypot
    const honeypot = form.querySelector('[name="honeypot"]');
    if (honeypot && honeypot.value) {
      isValid = false;
    }
    
    return isValid;
  }
  
  function showFieldError(field, message) {
    field.classList.add('form-input--error');
    const errorEl = document.querySelector(`[data-error="${field.name}"]`);
    if (errorEl) {
      errorEl.textContent = message;
    }
  }
  
  // centen → euro formatter
  function formatEuroCents(cents) {
    if (!cents) return '-';
    return (cents / 100).toLocaleString('nl-NL', {
      style: 'currency',
      currency: 'EUR'
    });
  }
  // Handle form submission
  function handleSubmit(event) {
    event.preventDefault();
    
    if (!validateForm()) {
      return;
    }
    
    // Disable submit button
    submitButton.disabled = true;
    document.querySelector('[data-submit-text]').classList.add('hidden');
    document.querySelector('[data-submit-loading]').classList.remove('hidden');
    
    // Collect form data
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    delete data.honeypot;
    
    console.log('Form data to submit:', data);
    
    // Simulate API call (MVP)
    setTimeout(() => {
      showSuccess();
      sessionStorage.removeItem('leaseRequest');
      
      submitButton.disabled = false;
      document.querySelector('[data-submit-text]').classList.remove('hidden');
      document.querySelector('[data-submit-loading]').classList.add('hidden');
    }, 1000);
    
    // TODO: Replace with actual fetch to your custom app
  }
  
  function showSuccess() {
    form.classList.add('hidden');
    successMessage.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  
  function showError() {
    formError.classList.remove('hidden');
    window.scrollTo({ top: formError.offsetTop - 100, behavior: 'smooth' });
  }
  
  // Initialize
  function init() {
    const data = loadLeaseData();
    if (data) {
      populateForm(data);
    }
    
    if (form) {
      form.addEventListener('submit', handleSubmit);
    }
    
    // Real-time validation
    const inputs = form.querySelectorAll('[data-customer-field]');
    inputs.forEach(input => {
      input.addEventListener('blur', () => {
        if (input.hasAttribute('required') && !input.value.trim()) {
          showFieldError(input, 'Dit veld is verplicht');
        } else {
          input.classList.remove('form-input--error');
          const errorEl = document.querySelector(`[data-error="${input.name}"]`);
          if (errorEl) errorEl.textContent = '';
        }
      });
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% stylesheet %}
input::placeholder {
  opacity: 0.5;
}
  .lease-request-section {
    width: 100%;
  }

  /* Two Column Layout */
  .lease-request-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-3xl);
  }

  @media screen and (min-width: 990px) {
    .lease-request-layout {
      grid-template-columns: 700px 1fr;
      align-items: start;
    }
  }

  /* Left Sidebar */
  .lease-request-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--padding-lg));
  }

  .lease-request-heading {
    margin-bottom: var(--margin-md);
  }

  .lease-request-subheading {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    margin-bottom: var(--margin-xl);
  }

  .lease-request-content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .content-block {
    padding: var(--padding-md);
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border-radius: var(--style-border-radius-inputs);
  }

  .content-block h3,
  .content-block h4 {
    margin-bottom: var(--margin-sm);
  }

  .icon-with-text-item {
    display: flex;
    gap: var(--gap-md);
    align-items: flex-start;
  }

  .icon-wrapper {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
  }

  .content-block--image img {
    width: 100%;
    height: auto;
    border-radius: var(--style-border-radius-inputs);
  }

  /* Form Wrapper */
  .lease-request-form-wrapper {
    width: 100%;
  }

  /* Form Sections */
  .form-section {
    background: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-xl);
    margin-bottom: var(--margin-xl);
  }

  .form-section-title {
    font-size: var(--font-size--lg);
    margin-bottom: var(--margin-lg);
    padding-bottom: var(--padding-sm);
    border-bottom: 1px solid var(--color-border);
  }

  /* Form Grid - Two Column */
  .form-grid {
    display: grid;
    gap: var(--gap-md);
  }

  .form-grid--two-column {
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .form-grid--two-column {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .form-group--full-width {
    grid-column: 1 / -1;
  }

  /* Form Groups */
  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-label {
    display: block;
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--margin-xs);
    font-size: var(--font-size--sm);
  }

  .required {
    color: var(--color-error, #d00);
  }

  /* Form Inputs */
  .form-input,
  select.form-input {
    width: 100%;
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-sm) var(--padding-md);
    font-family: inherit;
    font-size: var(--font-size--md);
    transition: border-color 0.2s ease;
  }

  .form-input:focus,
  select.form-input:focus {
    outline: none;
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 1px var(--color-foreground);
  }

  .form-input--error {
    border-color: var(--color-error, #d00);
  }

  /* Readonly Fields */
  .form-group--readonly .form-input {
    background: rgb(var(--color-foreground-rgb) / 0.03);
    cursor: not-allowed;
  }

  .form-group--highlight {
    margin-top: var(--margin-md);
  }

  .form-group--highlight .form-input {
  /*  background: var(--color-primary, #000);
    color: var(--color-background, #fff);*/
    border-color: var(--color-primary, #000);
    font-size: var(--font-size--xl);
    font-weight: var(--font-weight-bold);
  /*  text-align: center;*/
  }

  .form-group--highlight .form-label {
    color: inherit;
  }

  /* Form Errors */
  .form-error {
    display: block;
    color: var(--color-error, #d00);
    font-size: var(--font-size--sm);
    margin-top: var(--margin-2xs);
    min-height: 1.2em;
  }

  /* Privacy Disclaimer */
  .form-privacy {
    padding: var(--padding-md);
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border-radius: var(--style-border-radius-inputs);
    margin-bottom: var(--margin-lg);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .form-privacy a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Form Actions */
  .form-actions {
    display: flex;
    justify-content: center;
    margin-top: var(--margin-2xl);
  }

  .form-actions .button {
    min-width: 200px;
    padding-inline: var(--padding-4xl);
  }

  /* Form Messages */
  .form-message {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-sm);
    padding: var(--padding-md);
    border-radius: var(--style-border-radius-inputs);
    margin-top: var(--margin-lg);
  }

  .form-message--error {
    background: rgb(255 0 0 / 0.1);
    border: 1px solid rgb(255 0 0 / 0.3);
    color: var(--color-error, #d00);
  }

  .form-message .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  /* Error State */
  .lease-request-error {
    text-align: center;
    padding: var(--padding-4xl) var(--padding-xl);
  }

  .lease-request-error__content {
    max-width: 500px;
    margin: 0 auto;
  }

  .lease-request-error .svg-wrapper {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--margin-lg);
    color: var(--color-error, #d00);
  }

  .lease-request-error h2 {
    margin-bottom: var(--margin-md);
  }

  .lease-request-error p {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    margin-bottom: var(--margin-xl);
  }

  /* Success State */
  .lease-request-success {
    text-align: center;
    padding: var(--padding-4xl) var(--padding-xl);
  }

  .lease-request-success__content {
    max-width: 500px;
    margin: 0 auto;
  }

  .svg-wrapper--success {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--margin-lg);
    color: var(--color-success, #00a000);
  }

  .lease-request-success h2 {
    margin-bottom: var(--margin-md);
  }

  .lease-request-success p {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    margin-bottom: var(--margin-xl);
  }

  /* Utility */
  .hidden {
    display: none !important;
  }

  [data-submit-button]:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media screen and (max-width: 989px) {
    .lease-request-sidebar {
      position: relative;
      top: auto;
    }
  }
{% endstylesheet %}

